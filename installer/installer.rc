#define IDI_APP_ICON 101
#define IDR_BUNDLE_PAYLOAD 200

IDI_APP_ICON ICON "assets\\app.ico"
IDR_BUNDLE_PAYLOAD RCDATA "payload.bin"

1 24 "installer\\installer.manifest"

1 VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bad Piggies Widget Team\0"
            VALUE "FileDescription", "Bad Piggies Dota 2 Widget Installer\0"
            VALUE "FileVersion", "2.1.0.0\0"
            VALUE "InternalName", "BadPiggiesSetup.exe\0"
            VALUE "LegalCopyright", "© 2026 Bad Piggies Widget\0"
            VALUE "OriginalFilename", "BadPiggiesSetup.exe\0"
            VALUE "ProductName", "Bad Piggies Dota 2 Widget\0"
            VALUE "ProductVersion", "2.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
